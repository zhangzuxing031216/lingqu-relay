# 复制为 .env 后填写；.env 已被 .gitignore 忽略，绝对不要提交。
# 这里的值只给本仓库脚本用，不会自动写进 new-api。

# 站点域名（健康检查用，带 https）
DOMAIN=www.example.com
HEALTH_URL=https://www.example.com/api/status

# new-api 本机地址（一般不用改）
NEWAPI_BASE=http://127.0.0.1:3000
# 管理令牌或普通令牌；用于 probe-models.py
NEWAPI_KEY=REPLACE_ME

# 备份
BACKUP_DIR=/root/backups
BACKUP_KEEP_DB_DAYS=7
BACKUP_KEEP_OPS_DAYS=14
# 异地备份，例如 user@backup-host:/backups/lingqu/
BACKUP_REMOTE=

# 数据目录（一般不用改）
DATA_DIR=/opt/new-api/data
STATIC_DIR=/opt/new-api/static